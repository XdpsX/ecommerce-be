SPRING_PROFILES_ACTIVE=dev
REVISION=0.0.1-SNAPSHOT
SERVER_PORT=8080

DB_HOST=localhost
DB_PORT=3306
DB_NAME=ecommerce
DB_USER=xdpsx
DB_PASSWORD=xdpsxpass
DB_ROOT_PASSWORD=rootpass

JWT_SECRET=replace-with-a-random-secret-at-least-32-characters

# Dev-only: opt in after registering this LOCAL account to promote it at startup.
APP_BOOTSTRAP_ADMIN_ENABLED=false
APP_BOOTSTRAP_ADMIN_EMAIL=

CLOUDINARY_API_KEY=CLOUDINARY_API_KEY
CLOUDINARY_API_SECRET=CLOUDINARY_API_SECRET
CLOUDINARY_CLOUD_NAME=CLOUDINARY_CLOUD_NAME
# Required for real uploads: public HTTPS URL that forwards to POST /webhooks/cloudinary/eager.
CLOUDINARY_EAGER_NOTIFICATION_URL=https://your-public-tunnel.example/webhooks/cloudinary/eager
# Cloudinary notification signature age limit.
CLOUDINARY_WEBHOOK_TIMESTAMP_TOLERANCE=2h

GOOGLE_CLIENT_ID=GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=GOOGLE_CLIENT_SECRET

VNPAY_TMN_CODE=VNPAY_TMN_CODE
VNPAY_SECRET_KEY=VNPAY_SECRET_KEY
